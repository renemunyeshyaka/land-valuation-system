# ==========================================
# BACKEND - PRODUCTION (Namecheap VPS)
# ==========================================
# IMPORTANT: Copy this file to .env.production and fill in actual values
# DO NOT commit .env.production to Git!

# Application
APP_NAME=Land Valuation System · Rwanda
NODE_ENV=production

# Server Configuration
PORT=5001
BACKEND_URL=https://your-domain.com/api
FRONTEND_URL=https://your-domain.com/

# Database (PostgreSQL) - PRODUCTION
# NOTE: Update these with your actual Namecheap VPS database credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_secure_database_password
DATABASE_URL=postgres://user:password@localhost:5432/database_name?sslmode=require

# JWT & Security
# IMPORTANT: Generate a strong random secret for production (min 32 chars)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secure-random-jwt-secret-min-32-chars
JWT_EXPIRY=1d

# Email Configuration (SMTP)
# Use your production email service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@your-domain.com

# Email sender information
EMAIL_FROM=Land Valuation System <noreply@your-domain.com>
EMAIL_SUPPORT=support@your-domain.com

# Admin Configuration
#ADMIN_EMAIL=munyeshyaka@hotmail.com
#ADMIN_PASSWORD=your-secure-admin-password
#ADMIN_PHONE=+250788XXXXXX

# ========================================
# Payment Integration - PesaPal
# ========================================
PAYMENT_ENABLED=true
PAYMENT_PROVIDER=pesapal

# PesaPal API Configuration
PESAPAL_ENVIRONMENT=production
PESAPAL_API_URL=https://www.pesapal.com
PESAPAL_CONSUMER_KEY=your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=your-pesapal-consumer-secret
PESAPAL_CALLBACK_URL=https://your-domain.com/api/payment/callback
PESAPAL_IPN_ID=your-pesapal-ipn-id

# ========================================
# Payment Integration - PayPal
# ========================================
PAYPAL_ENVIRONMENT=production
PAYPAL_API_URL=https://api-m.paypal.com
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_URL=https://your-domain.com/api/v1/payments/paypal/webhook

# ========================================
# Bank Transfer Integration (Equity Bank Rwanda)
# ========================================
EQUITY_BANK_ACCOUNT=your-equity-bank-account
EQUITY_BANK_SWIFT=your-bank-swift-code
EQUITY_BANK_NAME=Equity Bank Rwanda
EQUITY_BANK_BRANCH=Kigali Main Branch

# ========================================
# Blockchain Payment (BNB Smart Chain)
# ========================================
BLOCKCHAIN_WALLET_ADDRESS=0xYourWalletAddressHere
BSCSCAN_API_KEY=your-bscscan-api-key

# File Upload Configuration
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=/var/www/landval/uploads

# Logging
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=https://your-domain.com/

# SSL/TLS (if behind reverse proxy)
TRUST_PROXY=true

# Upload directories (relative to backend root)
UPLOAD_DIR_PROFILES=uploads/profiles
UPLOAD_DIR_SIGNATURES=uploads/signatures
UPLOAD_DIR_VERIFICATION=uploads/verification

# Allowed file types
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg
ALLOWED_DOCUMENT_TYPES=image/jpeg,image/png,application/pdf

# ========================================
# Feature Flags
# ========================================
ENABLE_PAYMENTS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_MOBILE_APP=true
ENABLE_REFERRAL_PROGRAM=true
ENABLE_FREEMIUM_TIER=true
ENABLE_CORPORATE_PARTNERSHIPS=true
PAYMENT_METHODS=PesaPal,PayPal

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth endpoints rate limiting (stricter)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ========================================
# Logging & Monitoring
# ========================================
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# ========================================
# OTP Configuration
# ========================================
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Verification expiry for provisional access (days)
PROVISIONAL_ACCESS_DAYS=14

# ========================================
# Admin Configuration
# ========================================
# Admin email addresses (comma-separated)
ADMIN_EMAILS=admin@your-domain.com

# ========================================
# Maps & Geolocation
# ========================================
MAPBOX_TOKEN=your-mapbox-api-token
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ========================================
# Development/Debug Settings
# ========================================
DEBUG=false
ENABLE_SWAGGER_DOCS=false
