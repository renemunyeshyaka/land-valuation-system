# ============================================
# Docker Compose Environment Variables — TEMPLATE
# Copy this file to .env and fill in your values.
# .env is gitignored — secrets stay local.
# ============================================

# PostgreSQL
POSTGRES_HOST_PORT=5432
POSTGRES_DB=land_valuation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# Backend
BACKEND_PORT=8080
BACKEND_DB_HOST=postgres
BACKEND_DB_PORT=5432
BACKEND_DB_USER=postgres
BACKEND_DB_PASSWORD=change_me
BACKEND_DB_NAME=land_valuation

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
MAPBOX_TOKEN=your_mapbox_token_here

# PgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me
